# Generate a long random value. Never expose this token to browser JavaScript.
AUTOHUNT_API_KEY=replace-with-a-long-random-token

# Fernet key for private profile/resumes and lossless runtime state at rest.
# Without a key, runtime SQLite stays local plaintext; never expose/export it.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOHUNT_DATA_KEY=

AUTOHUNT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AUTOHUNT_RATE_LIMIT=60
AUTOHUNT_LOG_LEVEL=INFO

# Server defaults. A user-approved encrypted configuration can override these.
AUTOHUNT_LLM_PROVIDER=mock
AUTOHUNT_LLM_MODEL=mock-autohunt-v1

# Shared model-input budget (estimated tokens, NOT exact provider tokenizer).
# Effective input <= min(INPUT, WINDOW - actual output cap - RESERVE).
# Tune WINDOW to the configured provider/model. Required state is never sliced.
AUTOHUNT_CONTEXT_WINDOW_TOKENS=65536
AUTOHUNT_CONTEXT_INPUT_TOKENS=48000
AUTOHUNT_CONTEXT_OUTPUT_TOKENS=8192
AUTOHUNT_CONTEXT_RESERVE_TOKENS=1024
AUTOHUNT_CONTEXT_HISTORY_TURNS=8
AUTOHUNT_CONTEXT_HISTORY_TOKENS=6000
AUTOHUNT_CONTEXT_SESSION_TOKENS=16000
AUTOHUNT_CONTEXT_ROUTING_TOKENS=6000

# Optional server-managed credential. BYOK credentials are encrypted separately.
DEEPSEEK_API_KEY=

# Headed mode is required for local login, CAPTCHA and MFA takeover.
AUTOHUNT_BROWSER_HEADLESS=false

# auto: first attach to Chrome CDP, then fall back to an Agent-managed browser.
# To use your Chrome session, start Chrome with a dedicated user-data-dir and:
#   --remote-debugging-port=9223
AUTOHUNT_BROWSER_CDP_URL=http://127.0.0.1:9223

# --- 意图路由小模型（层 1，占位：配置 key+model 后自动启用） ---
# 未配置时路由自动降级为「规则 + 大模型兜底」，不影响任何功能。
# 推荐：SiliconFlow 的 Qwen/Qwen3-8B（或 Qwen/Qwen2.5-7B-Instruct）
AUTOHUNT_ROUTER_SMALL_API_KEY=
AUTOHUNT_ROUTER_SMALL_BASE_URL=https://api.siliconflow.cn/v1
AUTOHUNT_ROUTER_SMALL_MODEL=

# Action approval, independent of natural-language rules. risk is the default;
# always requires an independent confirmation (except stop/pause). risk accepts
# a recorded scoped instruction; unclassified actions require confirmation.
# HIGH lets ordinary search/local writes run. These settings cannot enable real
# site submission or override account/resume/one-use/uncertain-outcome checks.
AUTOHUNT_APPROVAL_POLICY=risk
AUTOHUNT_APPROVAL_THRESHOLD=HIGH

# Temporary local maintenance button. Set false to disable the destructive API.
AUTOHUNT_HISTORY_RESET_ENABLED=false
# Optional explicit path of the local simulator's SQLite database.
# Relative paths are anchored to agent/, not the process working directory.
# Empty disables simulator history reset; never point this at a real-site DB.
# From autohunt/agent, use ../../mock-site/job_site.db for the split workspace.
AUTOHUNT_MOCK_HISTORY_DATABASE=

# Cooperative watchdogs (seconds); human waiting does not consume active time.
AUTOHUNT_ACTIVE_TIMEOUT_SECONDS=900
AUTOHUNT_IDLE_TIMEOUT_SECONDS=180
AUTOHUNT_HUMAN_TIMEOUT_SECONDS=900
# Compatibility only: waiting for HR no longer expires. Active checks and
# verification still have deadlines; reply monitoring runs while Agent is up.
AUTOHUNT_REPLY_TIMEOUT_SECONDS=86400
AUTOHUNT_CONFIRMATION_TIMEOUT_SECONDS=86400
